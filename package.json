{
  "name": "nox-platform",
  "version": "1.0.0",
  "description": "Plateforme NOX — API, app mobile Expo et client web",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "test:server": "cd server && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "nodemailer": "^7.0.10",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "nox",
    "events",
    "mobile",
    "expo",
    "nightlife"
  ],
  "author": "NOX",
  "license": "MIT"
}
