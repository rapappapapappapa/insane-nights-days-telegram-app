{
  "name": "insane-nights-days-app",
  "version": "1.0.0",
  "description": "App Telegram moderne pour la plateforme Insane Nights & Days",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "telegraf": "^4.15.6",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  },
  "keywords": ["telegram", "app", "events", "insane", "ton", "blockchain"],
  "author": "Insane Corporation",
  "license": "MIT"
}
