generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String             @id @default(uuid())
  email                     String             @unique
  username                  String
  password                  String
  role                      UserRole           @default(USER)
  score                     Int                @default(0)
  level                     Int                @default(1)
  accountType               String?
  activeProfileType         String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  bannedAt                  DateTime?
  status                    UserStatus         @default(ACTIVE)
  suspendedUntil            DateTime?
  emailVerificationCodeHash String?
  emailVerificationSentAt   DateTime?
  emailVerified             Boolean            @default(false)
  emailVerifiedAt           DateTime?
  passwordResetCodeHash     String?
  passwordResetExpiresAt    DateTime?
  birthDate                 DateTime?
  adminActions              AdminActionLog[]
  feedNotificationsAsActor  FeedNotification[] @relation("NotificationActor")
  feedNotifications         FeedNotification[]
  feedPosts                 FeedPost[]
  postComments              FeedPostComment[]
  postLikes                 FeedPostLike[]
  followingBookers          FollowBooker[]
  followingDjs              FollowDj[]
  payments                  Payment[]
  reportsAssigned           Report[]           @relation("ReportsAssigned")
  reportsMade               Report[]           @relation("ReportsMade")
  tickets                   Ticket[]
  bookers                   UserBooker[]
  communities               UserCommunity[]
  djs                       UserDj[]
  venues                    UserVenue[]
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  adminId    String?
  adminNote  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  admin      User?            @relation("ReportsAssigned", fields: [adminId], references: [id])
  reporter   User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model UserCommunity {
  id                   String            @id @default(uuid())
  userId               String
  nom                  String
  prenom               String
  pays                 String
  dateNaissance        String
  isnNumber            String            @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  bannerImage          String?
  genres               String?
  profileImage         String?
  pseudo               String?   @unique
  friendshipsReceived  CommunityFriend[] @relation("FriendRequested")
  friendshipsRequested CommunityFriend[] @relation("FriendRequester")
  eventGroupsCreated   EventGroup[]
  eventGroupMemberships EventGroupMember[]
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookerCommunityFriends BookerCommunityFriend[]
  eventStaff           EventStaff[]

  @@index([userId])
}

model CommunityFriend {
  id                   String                @id @default(uuid())
  requesterCommunityId String
  requestedCommunityId String
  status               CommunityFriendStatus @default(PENDING)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  requested            UserCommunity         @relation("FriendRequested", fields: [requestedCommunityId], references: [id], onDelete: Cascade)
  requester            UserCommunity         @relation("FriendRequester", fields: [requesterCommunityId], references: [id], onDelete: Cascade)

  @@unique([requesterCommunityId, requestedCommunityId])
  @@index([requesterCommunityId])
  @@index([requestedCommunityId])
  @@index([status])
}

model UserDj {
  id                     String     @id @default(uuid())
  userId                 String
  artistName             String
  city                   String
  phone                  String
  birthDate              String
  bio                    String?
  genre                  String?
  mainCity               String?
  languages              String?
  profileImage           String?
  bannerImage            String?
  hourlyRate             Float?
  performanceRate        Float?
  minTravelFee           Float?
  extraFees              Float?
  availableDays          String?
  availableStatus        Boolean    @default(true)
  soundcloudUrl          String?
  spotifyUrl             String?
  youtubeUrl             String?
  instagramUrl           String?
  tiktokUrl              String?
  equipment              String?
  averageRatingCommunity Float      @default(0.0)
  averageRatingBooker    Float      @default(0.0)
  averageRatingVenue     Float      @default(0.0)
  averageRatingGlobal    Float      @default(0.0)
  totalRatingsCommunity  Int        @default(0)
  totalRatingsBooker     Int        @default(0)
  totalRatingsVenue      Int        @default(0)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  media                  DjMedia[]
  ratings                DjRating[]
  feedPosts              FeedPost[]
  followers              FollowDj[]
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserBooker {
  id                    String                   @id @default(uuid())
  userId                String
  nom                   String
  prenom                String
  phonePro              String
  bookerType            String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  profileImage          String?
  pseudo                String?
  events                Event[]
  feedPosts             FeedPost[]
  followers             FollowBooker[]
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookerCommunityFriends BookerCommunityFriend[]
  eventStaffAdded       EventStaff[]             @relation("StaffAddedBy")

  @@index([userId])
}

model UserVenue {
  id                     String        @id @default(uuid())
  userId                 String
  venueName              String
  address                String
  profileImage           String?
  bannerImage            String?
  averageRatingCommunity Float         @default(0.0)
  averageRatingBooker    Float         @default(0.0)
  averageRatingDj        Float         @default(0.0)
  averageRatingGlobal    Float         @default(0.0)
  totalRatingsCommunity  Int           @default(0)
  totalRatingsBooker     Int           @default(0)
  totalRatingsDj         Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  events                 Event[]
  eventVenues            EventVenue[]
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media                  VenueMedia[]
  ratings                VenueRating[]

  @@index([userId])
}

model DjRating {
  id        String   @id @default(uuid())
  djId      String
  raterId   String
  raterType String
  rating    Float
  comment   String?
  eventId   String
  ticketId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dj        UserDj   @relation(fields: [djId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id])
  ticket    Ticket?  @relation("DjRatingTickets", fields: [ticketId], references: [id])

  @@unique([djId, raterId, eventId])
  @@index([djId])
  @@index([raterId])
  @@index([eventId])
}

model VenueRating {
  id        String    @id @default(uuid())
  venueId   String
  raterId   String
  raterType String
  rating    Float
  comment   String?
  eventId   String
  ticketId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  event     Event     @relation(fields: [eventId], references: [id])
  ticket    Ticket?   @relation("VenueRatingTickets", fields: [ticketId], references: [id])
  venue     UserVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, raterId, eventId])
  @@index([venueId])
  @@index([raterId])
  @@index([eventId])
}

model VenueMedia {
  id         String    @id @default(uuid())
  venueId    String
  type       String
  url        String
  storageKey String?
  title      String?
  thumbnail  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  venue      UserVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([type])
}

model Event {
  id            String        @id @default(uuid())
  title         String
  date          DateTime
  time          String
  location      String
  price         Float
  capacity      Int
  sold          Int           @default(0)
  genre         String
  description   String?
  image         String?
  status          EventStatus   @default(UPCOMING)
  publishedOnFeed Boolean       @default(false)
  venueId         String?
  bookerId        String?
  createdAt       DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  djRatings     DjRating[]
  booker        UserBooker?   @relation(fields: [bookerId], references: [id])
  venue         UserVenue?    @relation(fields: [venueId], references: [id])
  eventDjs      EventDj[]
  eventVenues   EventVenue[]
  groupMessages Message[]
  payments      Payment[]
  tickets       Ticket[]
  venueRatings  VenueRating[]
  eventGroups   EventGroup[]
  eventStaff    EventStaff[]
}

model EventGroup {
  id                  String              @id @default(uuid())
  eventId             String
  creatorCommunityId  String
  name                String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator             UserCommunity       @relation(fields: [creatorCommunityId], references: [id], onDelete: Cascade)
  members             EventGroupMember[]

  @@unique([eventId, creatorCommunityId])
  @@index([eventId])
  @@index([creatorCommunityId])
}

model EventGroupMember {
  id          String              @id @default(uuid())
  groupId     String
  communityId String
  status      EventGroupMemberStatus @default(INVITED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  group       EventGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  community   UserCommunity       @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([groupId, communityId])
  @@index([groupId])
  @@index([communityId])
}

model EventDj {
  id               String                @id @default(uuid())
  eventId          String
  djId             String
  status           InvitationStatus      @default(PENDING)
  paymentStatus    BookingPaymentStatus  @default(UPCOMING)
  paymentAmount    Int?
  paymentCurrency  String                @default("eur")
  paidAt           DateTime?
  invoiceNumber    String?
  contractStatus   BookingContractStatus @default(DRAFT)
  contractVersion  Int                   @default(1)
  contractPayload  Json?
  contractHash     String?
  contractSentAt   DateTime?
  contractSentBy   ContractParty?
  bookerAcceptedAt DateTime?
  djAcceptedAt     DateTime?
  rejectionReason  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@unique([eventId, djId])
  @@index([eventId])
  @@index([djId])
  @@index([status])
}

model EventVenue {
  id                String                @id @default(uuid())
  eventId           String
  venueId           String
  status            InvitationStatus      @default(PENDING)
  paymentStatus     BookingPaymentStatus  @default(UPCOMING)
  paymentAmount     Int?
  paymentCurrency   String                @default("eur")
  paidAt            DateTime?
  invoiceNumber     String?
  contractStatus    BookingContractStatus @default(DRAFT)
  contractVersion   Int                   @default(1)
  contractPayload   Json?
  contractHash      String?
  contractSentAt    DateTime?
  contractSentBy    ContractPartyVenue?
  bookerAcceptedAt  DateTime?
  venueAcceptedAt   DateTime?
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  event             Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue             UserVenue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@unique([eventId, venueId])
}

model BookerCommunityFriend {
  id          String              @id @default(uuid())
  bookerId    String
  communityId String
  status      BookerFriendStatus  @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  booker      UserBooker          @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  community   UserCommunity      @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([bookerId, communityId])
  @@index([bookerId])
  @@index([communityId])
  @@index([status])
}

model EventStaff {
  id               String        @id @default(uuid())
  eventId          String
  communityId      String
  role             EventStaffRole @default(STAFF_SCAN)
  addedByBookerId  String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  community        UserCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  addedBy          UserBooker    @relation("StaffAddedBy", fields: [addedByBookerId], references: [id], onDelete: Cascade)

  @@unique([eventId, communityId])
  @@index([eventId])
  @@index([communityId])
}

model Message {
  id          String       @id @default(uuid())
  type        MessageType  @default(PRIVATE)
  eventDjId   String?
  eventVenueId String?
  eventId     String?
  senderId    String
  content     String
  read        Boolean      @default(false)
  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  eventDj     EventDj?     @relation(fields: [eventDjId], references: [id], onDelete: Cascade)
  eventVenue  EventVenue?  @relation(fields: [eventVenueId], references: [id], onDelete: Cascade)
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventDjId])
  @@index([eventVenueId])
  @@index([eventId])
  @@index([senderId])
  @@index([type])
  @@index([createdAt])
}

model Ticket {
  id              String        @id @default(uuid())
  userId          String
  eventId         String
  paymentIntentId String?
  price           Float
  status          String        @default("valid")
  qrCode          String        @unique
  purchaseDate    DateTime      @default(now())
  scannedAt       DateTime?
  djRatings       DjRating[]    @relation("DjRatingTickets")
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment         Payment?      @relation(fields: [paymentIntentId], references: [paymentIntentId])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueRatings    VenueRating[] @relation("VenueRatingTickets")

  @@index([userId])
  @@index([eventId])
  @@index([paymentIntentId])
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  eventId         String
  paymentIntentId String   @unique
  amount          Int
  currency        String   @default("eur")
  quantity        Int      @default(1)
  status          String   @default("created")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets         Ticket[]

  @@index([userId])
  @@index([eventId])
}

model DjMedia {
  id         String   @id @default(uuid())
  djId       String
  type       String
  url        String
  storageKey String?
  title      String?
  thumbnail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dj         UserDj   @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@index([djId])
  @@index([type])
}

model FeedPost {
  id              String             @id @default(uuid())
  authorId        String
  djId            String?
  bookerId        String?
  content         String
  imageUrl        String?
  imageStorageKey String?
  likes           Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  notifications   FeedNotification[]
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  booker          UserBooker?        @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  dj              UserDj?            @relation(fields: [djId], references: [id], onDelete: Cascade)
  comments        FeedPostComment[]
  postLikes       FeedPostLike[]

  @@index([authorId])
  @@index([djId])
  @@index([bookerId])
  @@index([createdAt])
}

model FeedPostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model FeedPostComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model FeedNotification {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  actorId   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@index([read])
  @@index([createdAt])
}

model FollowDj {
  id         String   @id @default(uuid())
  followerId String
  djId       String
  createdAt  DateTime @default(now())
  dj         UserDj   @relation(fields: [djId], references: [id], onDelete: Cascade)
  follower   User     @relation(fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, djId])
  @@index([followerId])
  @@index([djId])
}

model FollowBooker {
  id         String     @id @default(uuid())
  followerId String
  bookerId   String
  createdAt  DateTime   @default(now())
  booker     UserBooker @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  follower   User       @relation(fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, bookerId])
  @@index([followerId])
  @@index([bookerId])
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ReportTargetType {
  FEED_POST
  EVENT
  USER
  DJ_PROFILE
  BOOKER_PROFILE
  VENUE_PROFILE
}

enum ReportReason {
  SPAM
  HARASSMENT
  SCAM
  ILLEGAL
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum CommunityFriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum BookerFriendStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum EventStaffRole {
  STAFF_SCAN
}

enum EventGroupMemberStatus {
  INVITED
  JOINED
  DECLINED
}

enum EventStatus {
  UPCOMING
  ONGOING
  FINISHED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum BookingPaymentStatus {
  UPCOMING
  PENDING
  PAID
}

enum BookingContractStatus {
  DRAFT
  SENT
  SIGNED
}

enum ContractParty {
  BOOKER
  DJ
}

enum ContractPartyVenue {
  BOOKER
  VENUE
}

enum MessageType {
  PRIVATE
  GROUP
}
