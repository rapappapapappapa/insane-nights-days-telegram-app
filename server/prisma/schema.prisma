// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ✅ Rôles pour administration (prod)
enum UserRole {
  USER
  ADMIN
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String
  password          String
  role              UserRole @default(USER)
  score             Int      @default(0)
  level             Int      @default(1)
  accountType       String? // 'COMMUNITY', 'DJ', 'BOOKER', 'VENUE' (déprécié, utiliser activeProfileType)
  activeProfileType String? // 'COMMUNITY', 'DJ', 'BOOKER', 'VENUE' - Profil actuellement actif
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations vers les profils spécifiques (plusieurs profils possibles)
  communities UserCommunity[]
  djs         UserDj[]
  bookers     UserBooker[]
  venues      UserVenue[]

  // Relations vers les tickets
  tickets Ticket[]
  // ✅ Paiements
  payments Payment[]
  // Relations vers les posts du feed
  feedPosts FeedPost[]
  // ✅ AJOUT: Relations vers les likes et commentaires
  postLikes FeedPostLike[]
  postComments FeedPostComment[]
  // ✅ AJOUT: Relations vers les notifications
  feedNotifications FeedNotification[] // Notifications reçues
  feedNotificationsAsActor FeedNotification[] @relation("NotificationActor") // Notifications créées (en tant qu'acteur)
}

model UserCommunity {
  id            String   @id @default(uuid())
  userId        String // Plusieurs profils Community possibles par User
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nom           String
  prenom        String
  pays          String
  dateNaissance String // Format: jj/mm/aaaa
  isnNumber     String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model UserDj {
  id                     String   @id @default(uuid())
  userId                 String // Plusieurs profils DJ possibles par User
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistName             String
  city                   String
  phone                  String
  birthDate              String
  bio                    String? // Bio du DJ
  genre                  String? // Genre musical principal
  mainCity               String? // Ville principale
  languages              String? // Langues parlées (séparées par virgules)
  profileImage           String? // URL de la photo de profil
  bannerImage            String? // URL de la bannière
  hourlyRate             Float? // Tarif horaire
  performanceRate        Float? // Tarif par prestation
  minTravelFee           Float? // Tarif minimum déplacement
  extraFees              Float? // Frais supplémentaires
  availableDays          String? // Jours disponibles (JSON string)
  availableStatus        Boolean  @default(true) // Statut de disponibilité
  // Réseaux sociaux
  soundcloudUrl          String? // URL SoundCloud
  spotifyUrl             String? // URL Spotify
  youtubeUrl             String? // URL YouTube
  instagramUrl           String? // URL Instagram
  tiktokUrl              String? // URL TikTok
  equipment              String? // Matériel & rider (texte)
  averageRatingCommunity Float    @default(0.0)
  averageRatingBooker    Float    @default(0.0)
  averageRatingVenue     Float    @default(0.0)
  averageRatingGlobal    Float    @default(0.0)
  totalRatingsCommunity  Int      @default(0)
  totalRatingsBooker     Int      @default(0)
  totalRatingsVenue      Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations vers les notes reçues
  ratings DjRating[]
  // Relations vers les médias
  media   DjMedia[]
  // Relations vers les posts du feed
  feedPosts FeedPost[]

  @@index([userId])
}

model UserBooker {
  id         String   @id @default(uuid())
  userId     String // Plusieurs profils Booker possibles par User
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nom        String
  prenom     String
  phonePro   String
  bookerType String
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations vers les événements organisés
  events Event[]
  // Relations vers les posts du feed
  feedPosts FeedPost[]

  @@index([userId])
}

model UserVenue {
  id                     String   @id @default(uuid())
  userId                 String // Plusieurs profils Venue possibles par User
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueName              String
  address                String
  averageRatingCommunity Float    @default(0.0)
  averageRatingBooker    Float    @default(0.0)
  averageRatingDj        Float    @default(0.0)
  averageRatingGlobal    Float    @default(0.0)
  totalRatingsCommunity  Int      @default(0)
  totalRatingsBooker     Int      @default(0)
  totalRatingsDj         Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations vers les événements hébergés
  events  Event[]
  // Relations vers les notes reçues
  ratings VenueRating[]
  // Relations vers les médias
  media   VenueMedia[]

  @@index([userId])
}

// Modèle pour stocker les notes données aux DJs
model DjRating {
  id        String   @id @default(uuid())
  djId      String
  dj        UserDj   @relation(fields: [djId], references: [id], onDelete: Cascade)
  raterId   String // ID de l'utilisateur qui note (User.id)
  raterType String // 'COMMUNITY', 'BOOKER', 'VENUE'
  rating    Float // Note de 1 à 5
  comment   String? // Commentaire optionnel
  eventId   String // ID de l'événement lié (obligatoire)
  event     Event    @relation(fields: [eventId], references: [id])
  ticketId  String? // ID du ticket (pour la communauté)
  ticket    Ticket?  @relation("DjRatingTickets", fields: [ticketId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([djId, raterId, eventId]) // Une note par DJ/Utilisateur/Événement
  @@index([djId])
  @@index([raterId])
  @@index([eventId])
}

// Modèle pour stocker les notes données aux Lieux
model VenueRating {
  id        String    @id @default(uuid())
  venueId   String
  venue     UserVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  raterId   String // ID de l'utilisateur qui note (User.id)
  raterType String // 'COMMUNITY', 'BOOKER', 'DJ'
  rating    Float // Note de 1 à 5
  comment   String? // Commentaire optionnel
  eventId   String // ID de l'événement lié (obligatoire)
  event     Event     @relation(fields: [eventId], references: [id])
  ticketId  String? // ID du ticket (pour la communauté)
  ticket    Ticket?   @relation("VenueRatingTickets", fields: [ticketId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([venueId, raterId, eventId]) // Une note par Lieu/Utilisateur/Événement
  @@index([venueId])
  @@index([raterId])
  @@index([eventId])
}

// Médias pour les lieux (photos / vidéos)
model VenueMedia {
  id        String    @id @default(uuid())
  venueId   String
  venue     UserVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  type      String // 'photo' ou 'video'
  url       String
  storageKey String? // ✅ clé objet (R2/S3) si stockage externe
  title     String?
  thumbnail String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([venueId])
  @@index([type])
}

// Enum pour le statut des événements
enum EventStatus {
  UPCOMING // À venir
  ONGOING // En cours
  FINISHED // Terminé
}

// Enum pour le statut d'invitation d'un DJ à un événement
enum InvitationStatus {
  PENDING // En attente de réponse
  ACCEPTED // Acceptée
  REJECTED // Refusée
}

// Modèle pour les événements
model Event {
  id          String      @id @default(uuid())
  title       String
  date        DateTime // Date de l'événement
  time        String
  location    String // Adresse textuelle (pour compatibilité)
  price       Float
  capacity    Int
  sold        Int         @default(0)
  genre       String
  description String?
  image       String?
  status      EventStatus @default(UPCOMING) // Statut de l'événement

  // Relations
  venueId  String?
  venue    UserVenue?  @relation(fields: [venueId], references: [id])
  bookerId String?
  booker   UserBooker? @relation(fields: [bookerId], references: [id])

  // Table de jointure pour les DJs (many-to-many)
  eventDjs EventDj[]

  // Relations vers les tickets et notes
  tickets      Ticket[]
  // ✅ Paiements
  payments     Payment[]
  djRatings    DjRating[]
  venueRatings VenueRating[]

  // Messages de groupe pour cet événement
  groupMessages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Table de jointure pour Event <-> DJ (many-to-many)
model EventDj {
  id        String           @id @default(uuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  djId      String // User.id du DJ
  status    InvitationStatus @default(PENDING) // Statut de l'invitation

  // ✅ Paiement booking (Booker -> DJ) - MVP: statut + facture
  paymentStatus BookingPaymentStatus @default(UPCOMING)
  paymentAmount Int?                // en centimes (ex: 50000 = 500€)
  paymentCurrency String            @default("eur")
  paidAt        DateTime?
  invoiceNumber String?

  // ✅ Contrat booking (Booker <-> DJ) - MVP intégré au chat privé
  contractStatus BookingContractStatus @default(DRAFT)
  contractVersion Int                 @default(1)
  contractPayload Json?
  contractHash    String?
  contractSentAt  DateTime?
  contractSentBy  ContractParty?
  bookerAcceptedAt DateTime?
  djAcceptedAt     DateTime?

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Messages liés à cette invitation
  messages Message[]

  @@unique([eventId, djId])
  @@index([eventId])
  @@index([djId])
  @@index([status])
}

// ✅ Statut de paiement d'un booking (Booker -> DJ)
enum BookingPaymentStatus {
  UPCOMING // à venir (pas encore dû / event à venir)
  PENDING  // en attente (dû mais non payé)
  PAID     // payé
}

// ✅ Statut de contrat d'un booking
enum BookingContractStatus {
  DRAFT // brouillon (modifiable par booker)
  SENT  // envoyé (dernière proposition en attente de l'autre partie)
  SIGNED // signé par les deux parties (booker + DJ)
}

// ✅ Qui a envoyé la dernière proposition
enum ContractParty {
  BOOKER
  DJ
}

// Enum pour le type de message
enum MessageType {
  PRIVATE // Chat privé entre booker et un DJ (lié à EventDj)
  GROUP // Chat de groupe pour tous les DJs d'un événement (lié à Event)
}

// Modèle pour les messages de chat entre DJ et Booker
model Message {
  id        String      @id @default(uuid())
  type      MessageType @default(PRIVATE) // Type de message (PRIVATE ou GROUP)
  eventDjId String? // ID de l'invitation (EventDj) - obligatoire si type=PRIVATE
  eventDj   EventDj?    @relation(fields: [eventDjId], references: [id], onDelete: Cascade)
  eventId   String? // ID de l'événement - obligatoire si type=GROUP
  event     Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId  String // User.id de l'expéditeur (DJ ou Booker)
  content   String // Contenu du message
  read      Boolean     @default(false) // Message lu ou non
  deleted   Boolean     @default(false) // Message supprimé (contenu masqué)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([eventDjId])
  @@index([eventId])
  @@index([senderId])
  @@index([type])
  @@index([createdAt])
}

// Modèle pour les tickets
model Ticket {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // 🔒 Lien optionnel vers un paiement Stripe (idempotence / traçabilité)
  // On référence Payment.paymentIntentId (unique) pour pouvoir retrouver les tickets d'un achat.
  paymentIntentId String?
  payment         Payment? @relation(fields: [paymentIntentId], references: [paymentIntentId], onDelete: SetNull)
  price        Float
  status       String   @default("valid") // 'valid', 'used', 'cancelled'
  qrCode       String   @unique
  purchaseDate DateTime @default(now())

  // Relations vers les notes
  djRatings    DjRating[]    @relation("DjRatingTickets")
  venueRatings VenueRating[] @relation("VenueRatingTickets")

  @@index([userId])
  @@index([eventId])
  @@index([paymentIntentId])
}

// ✅ Paiements Stripe (idempotence + traçabilité)
model Payment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentIntentId String   @unique
  tickets         Ticket[]
  amount          Int      // en centimes
  currency        String   @default("eur")
  quantity        Int      @default(1)
  status          String   @default("created") // created | succeeded | fulfilled | failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([eventId])
}

// Modèle pour stocker les médias des DJs (photos, vidéos, audio)
model DjMedia {
  id        String   @id @default(uuid())
  djId      String
  dj        UserDj   @relation(fields: [djId], references: [id], onDelete: Cascade)
  type      String // 'photo', 'video', 'audio'
  url       String // URL du fichier (pour l'instant, on stocke juste l'URI local, à remplacer par une vraie URL de stockage)
  storageKey String? // ✅ clé objet (R2/S3) si stockage externe
  title     String? // Titre optionnel
  thumbnail String? // URL de la miniature (pour vidéos)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([djId])
  @@index([type])
}

// ✅ AJOUT: Modèle pour les posts du feed d'actualité
// Les DJs et Bookers peuvent créer des posts qui apparaissent dans le feed
model FeedPost {
  id        String    @id @default(uuid())
  authorId  String    // User.id de l'auteur (DJ ou Booker)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  djId      String?   // UserDj.id pour récupérer les infos du DJ (optionnel si c'est un DJ)
  dj        UserDj?   @relation(fields: [djId], references: [id], onDelete: Cascade)
  bookerId  String?   // UserBooker.id pour récupérer les infos du Booker (optionnel si c'est un Booker)
  booker    UserBooker? @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  content   String    // Contenu textuel du post
  imageUrl  String?   // URL de l'image (optionnel)
  imageStorageKey String? // ✅ clé objet (R2/S3) si stockage externe
  likes     Int       @default(0) // Compteur de likes (déprécié, utiliser FeedPostLike)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ✅ AJOUT: Relations vers les likes et commentaires
  postLikes    FeedPostLike[]
  comments     FeedPostComment[]
  // ✅ AJOUT: Relations vers les notifications
  notifications FeedNotification[]

  @@index([authorId])
  @@index([djId])
  @@index([bookerId])
  @@index([createdAt]) // Pour trier par date décroissante
}

// ✅ AJOUT: Modèle pour tracker qui a liké quel post
model FeedPostLike {
  id        String   @id @default(uuid())
  postId    String   // FeedPost.id
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   // User.id de l'utilisateur qui a liké
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId]) // Un utilisateur ne peut liker qu'une fois par post
  @@index([postId])
  @@index([userId])
}

// ✅ AJOUT: Modèle pour les commentaires sur les posts
model FeedPostComment {
  id        String   @id @default(uuid())
  postId    String   // FeedPost.id
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   // User.id de l'utilisateur qui commente
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   // Contenu du commentaire
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([createdAt]) // Pour trier par date
}

// ✅ AJOUT: Modèle pour les notifications d'interactions sur les posts
model FeedNotification {
  id        String   @id @default(uuid())
  userId    String   // User.id du propriétaire du post (qui reçoit la notification)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   // FeedPost.id du post concerné
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorId   String   // User.id de la personne qui a interagi (like ou commentaire)
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      String   // 'like' ou 'comment'
  read      Boolean  @default(false) // Si la notification a été lue
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([postId])
  @@index([read])
  @@index([createdAt]) // Pour trier par date décroissante
}
